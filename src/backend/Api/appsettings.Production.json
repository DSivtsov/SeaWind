      "UUID": "Stable", // Stable/Real
      "ExistenData": "Fresh", // Fresh/NotDel
      "AutoMigrate": true // Возможно автоматической миграции в процессе сидирования
    },
    "AppIdentityDbContext": {
      "Enabled": true,
      "PathBase": "Identity/SeedData", // Проект by "CopyToOutputDirectory" копирует файлы с данными из проекта в рабочий каталог
      "Mode": "InsertOnly", // InsertOnly/InsertOrUpdate
      "UUID": "Stable", // Stable/Real
      "ExistenData": "Fresh", // Fresh/NotDel
      "AutoMigrate": true // Возможно автоматической миграции в процессе сидирования
