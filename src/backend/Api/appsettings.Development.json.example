{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=55432;Database=workshopcode;Username=wc_app;Password=wc_app_pwd;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "_comment": "Jwt:Key должен быть длиной не менее 32 символов (256 бит) и состоять только из ASCII-символов: A–Z, a–z, 0–9, -, _, =. Лучше использовать Base64-строку.",
  "Jwt": {
    "Issuer": "workshopcode",
    "Audience": "workshopcode.api",
    "Key": "DXaA1_usIbb-9txBxhqG36Hua0zXa2UWuXwafsFCfiA="
  },
  "Seed": {
    "CoreOption": {
      "FileNameDataTemplate": "Demo{Entity}.json", // Пример для сущности Tester "DemoTester.json"
      "FileNameSeedTemplate": "Demo{Entity}.seed.json", // Пример для сущности Tester "DemoTester.seed.json"
      "SuffixSeederClassName": "Seeder" // Пример для сущности "Tester"+"Seeder" = "TesterSeeder"
    },
    "TimeDbContext": {
      "Enabled": true,
      "PathBase": "Time/SeedData", // Проект by "CopyToOutputDirectory" копирует файлы с данными из проекта в рабочий каталог
      "Mode": "InsertOrUpdate",
      //OPTION TURN OFF "PathVersion": "Time/SeedData/v1", 
      "UUID": "Real", // Simple/Real/Stable
      "ExistenData": "Fresh", // Fresh/NotDel
      "AutoMigrate": false // Возможно автоматической миграции в процессе сидирования
    },
    "MainDbContext": {
      "Enabled": false,
      "PathBase": "Main/SeedData", // Проект by "CopyToOutputDirectory" копирует файлы с данными из проекта в рабочий каталог
      //OPTION TURN OFF "PathVersion": "Main/SeedData/v1",
      "Mode": "InsertOnly", // InsertOnly/InsertOrUpdate
      "UUID": "Real", // Simple/Real
      "ExistenData": "NotDel", // Fresh/NotDel
      "AutoMigrate": false // Возможно автоматической миграции в процессе сидирования
    }
  }
}